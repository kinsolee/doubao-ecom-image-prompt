  "intent": {
    "job_to_be_done": "把参考图手法或稀疏产品资料转成事实可追溯、产品保真、视觉系统一致、可逐图生成并增量返修的电商主图和详情页；明确要五张主图时默认执行 G1–G5 转化叙事，详情页从 M1–M8 选配；只有产品图或零散身份规格且无完整合格卖点集时先调研并确认卖点信息大纲。",
    "target_users": [
      "电商卖家与运营",
      "品牌与视觉设计师",
      "AI 生图用户"
    ],
    "inputs": [
      "参考图/商品链接，或用户产品图与基础资料",
      "目标平台、类目、SKU 和交付范围",
      "可选的品牌规范、视觉/版式参考与真实证据资产"
    ],
    "outputs": [
      "事实/证据/规则/动态字段账本与购买疑问地图",
      "详情页只有产品图或零散身份规格且无完整合格卖点集时的身份解析、调研来源、候选卖点池与待确认卖点信息大纲",
      "五张主图 G1–G5 默认策略或自适应主图策略，以及 M1–M8 选配的详情页大纲与全部逐屏执行稿；每张/模块只有画面、图内文案、设计指引三个用户可见一级项",
      "Visual System、参考资产/授权/传输方式、逻辑任务清单、五层编译提示词、豆包完整图文成片/局部改字和验收规格"
    ],
    "exclusions": [
      "纯营销文案或商品标题",
      "单纯抠图修图换背景",
      "翻译、销售数据分析或只评价图片"
    ]
  },
